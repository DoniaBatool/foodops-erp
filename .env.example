# Copy to .env.local and fill in. Never commit .env.local.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only (user invites, Week 1 later)

# Supabase > Connect > ORMs / Transaction pooler (port 6543). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres
# Session pooler / direct (port 5432), for scripts and drizzle-kit studio
DIRECT_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3000
